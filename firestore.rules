rules_version = '2';
// Правила безопасности OKTASHOP (Firebase Firestore).
// Деплой: Firebase Console → Firestore → Rules → вставить → Publish.
//
// Смысл:
//  - покупатель видит и правит ТОЛЬКО свой профиль (users/{uid});
//  - заказы (orders): читает только автор заказа, создать может только
//    залогиненный пользователь от своего uid, статус меняет только владелец
//    проекта (через Firebase Console) — покупатель не может себя «повысить»;
//  - всё остальное закрыто.
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {
      allow read, update: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'phone', 'email', 'createdAt']);
      allow delete: if false;
    }

    match /orders/{orderId} {
      allow read: if request.auth != null
        && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'new'
        && request.resource.data.subtotal is number
        && request.resource.data.name is string
        && request.resource.data.phone is string
        && request.resource.data.items is list;
      // Статусы подтверждает магазин (владелец проекта), не покупатель.
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
